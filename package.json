    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
